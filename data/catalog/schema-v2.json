{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dach1980.github.io/ai-research-dch-school/data/catalog/schema-v2.json",
  "title": "DCH School hierarchical curriculum catalog v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tracks",
    "themes",
    "modules",
    "lessons",
    "planets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    },
    "planets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planet"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.html$"
    },
    "i18nTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en",
        "zh"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "i18nUrl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en",
        "zh"
      ],
      "properties": {
        "ru": {
          "$ref": "#/$defs/path"
        },
        "en": {
          "$ref": "#/$defs/path"
        },
        "zh": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "title",
        "status",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^track-[a-z0-9-]+$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "planned",
            "archived"
          ]
        },
        "url": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "track_id",
        "code",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+$"
        },
        "track_id": {
          "type": "string",
          "pattern": "^track-[a-z0-9-]+$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "complete",
            "archived"
          ]
        },
        "title_i18n": {
          "$ref": "#/$defs/i18nTitle"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "theme_id",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+\\.[0-9]+$"
        },
        "theme_id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "complete",
            "archived"
          ]
        },
        "title_i18n": {
          "$ref": "#/$defs/i18nTitle"
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "title",
        "status",
        "access",
        "level",
        "duration_min",
        "duration_max",
        "prerequisites",
        "learning_outcomes",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+\\.[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "published",
            "unpublished"
          ]
        },
        "access": {
          "enum": [
            "open",
            "registered",
            "paid"
          ]
        },
        "level": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "duration_min": {
          "type": "integer",
          "minimum": 1
        },
        "duration_max": {
          "type": "integer",
          "minimum": 1
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "learning_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "$ref": "#/$defs/path"
        },
        "title_i18n": {
          "$ref": "#/$defs/i18nTitle"
        },
        "url_i18n": {
          "$ref": "#/$defs/i18nUrl"
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ru",
              "en",
              "zh"
            ]
          },
          "minItems": 3
        },
        "legacy_id": {
          "type": "string",
          "pattern": "^[A-Z][0-9]*\\.[0-9]+$"
        }
      }
    },
    "planet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lesson_id",
        "accent_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^planet-[A-Z]-[0-9]+$"
        },
        "lesson_id": {
          "type": "string",
          "pattern": "^[A-Z]\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "accent_id": {
          "enum": [
            "blue",
            "violet",
            "teal",
            "amber"
          ]
        }
      }
    }
  }
}
