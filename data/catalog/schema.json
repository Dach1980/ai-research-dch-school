{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dach1980.github.io/ai-research-dch-school/data/catalog/schema.json",
  "title": "DCH School content catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "code", "title", "status", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^track-[a-z0-9-]+$"},
          "code": {"type": "string", "pattern": "^[A-Z]$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "planned", "archived"]},
          "url": {"$ref": "#/$defs/relativeHtmlPath"}
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "track_id", "title", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^module-[0-9]+$"},
          "number": {"type": "integer", "minimum": 0},
          "track_id": {"type": "string", "pattern": "^track-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "in_progress", "complete", "archived"]}
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module_id", "track_id", "title", "status", "access", "level", "duration_min", "duration_max", "prerequisites", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][0-9]*\\.[0-9]+$"},
          "module_id": {"type": "string", "pattern": "^module-[0-9]+$"},
          "track_id": {"type": "string", "pattern": "^track-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "review", "published", "unpublished"]},
          "access": {"enum": ["open", "registered", "paid"]},
          "level": {"enum": ["beginner", "intermediate", "advanced"]},
          "duration_min": {"type": "integer", "minimum": 1},
          "duration_max": {"type": "integer", "minimum": 1},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][0-9]*\\.[0-9]+$"}},
          "learning_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "url": {"$ref": "#/$defs/relativeHtmlPath"}
        }
      }
    },
    "planets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lesson_id", "accent_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^planet-[A-Z]-[0-9]+$"},
          "lesson_id": {"type": "string", "pattern": "^[A-Z][0-9]*\\.[0-9]+$"},
          "accent_id": {"enum": ["blue", "violet", "teal", "amber"]}
        }
      }
    }
  },
  "$defs": {
    "relativeHtmlPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.html$"
    }
  }
}
